                    "text/plain"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Книги"
                ],
                "summary": "Список книг",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
